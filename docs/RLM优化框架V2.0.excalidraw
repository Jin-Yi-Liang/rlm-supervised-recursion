    {
      "id": "_8eJ1RcwMqYKhS9uJfwdG",
      "type": "text",
      "x": 4554.5467207087395,
      "y": 1607.5009014441061,
      "width": 469.87835693359375,
      "height": 275.2669085488671,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2WG",
